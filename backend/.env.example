# Use absolute paths on a persistent disk. Do not commit the real database.
CMS_DATABASE=/data/cms.sqlite3
CMS_UPLOADS=/data/uploads
# true in production; false only for localhost HTTP development.
CMS_COOKIE_SECURE=true
# Enable only behind one trusted reverse proxy that overwrites forwarding headers.
CMS_TRUST_PROXY=0
CMS_SITE_URL=https://tomzeidev.github.io/byteplay-html/
